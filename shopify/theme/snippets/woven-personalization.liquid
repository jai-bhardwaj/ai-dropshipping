{%- comment -%}
  Woven Tails: personalization fields inside the product form.
  Values are saved on the order line as properties (photo = file link in the order).
{%- endcomment -%}
{%- liquid
  assign h = product.handle
  assign wt_photo = false
  assign wt_story = false
  if h contains 'blanket' or h contains 'gift-set' or h == 'personalized-pet-storybook'
    assign wt_photo = true
  endif
  if h == 'personalized-pet-storybook' or h contains 'gift-set'
    assign wt_story = true
  endif
  assign wt_blanket = false
  if h contains 'blanket' or h contains 'gift-set'
    assign wt_blanket = true
  endif
-%}
{%- if wt_photo -%}
{%- if wt_blanket -%}
  <div data-wt-editor data-handle="{{ product.handle }}" data-addon="67733051965719"{% if wt_story %} data-require-name="true"{% endif %}></div>
  <script src="https://woven-tails.vercel.app/theme-assets/v6/wt-editor.js" defer></script>
{%- else -%}
  <section class="wt-card">
    <h3 class="wt-card__h"><span class="wt-card__n">2</span>Add your pet's photo</h3>
    <label class="wt-upload" for="wt-photo-{{ uid }}">
      <input id="wt-photo-{{ uid }}" class="wt-upload__input" type="file" name="properties[Pet photo]" accept="image/jpeg,image/png,image/heic,image/heif,image/webp">
      <span class="wt-upload__thumb" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h3l2-2h6l2 2h3v12H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
        <img alt="" hidden>
      </span>
      <span class="wt-upload__text">
        <strong class="wt-upload__label">Upload a photo</strong>
        <span class="wt-upload__hint">A clear photo of their face. Phone photos are perfect.</span>
      </span>
    </label>
    <p class="wt-small" data-wt-note="{{ uid }}">No photo handy? You can order now and reply to your confirmation email with it.</p>
  </section>
{%- endif -%}

{%- if wt_story -%}
  <section class="wt-card">
    <h3 class="wt-card__h"><span class="wt-card__n">{% if wt_blanket %}4{% else %}3{% endif %}</span>{% if wt_blanket %}Storybook details{% else %}Names in the story{% endif %}</h3>
    {%- unless wt_blanket -%}
    <label class="wt-field">
      <span>Pet's name</span>
      <input type="text" name="properties[Pet's name]" maxlength="24" autocomplete="off" required placeholder="e.g. Sunny">
    </label>
    {%- endunless -%}
    <label class="wt-field">
      <span>Family names <em>(up to 3, optional)</em></span>
      <input type="text" name="properties[Family names]" maxlength="60" autocomplete="off" placeholder="e.g. Emma, Jake and Grandma Rose">
    </label>
    <label class="wt-field">
      <span>Favorite treat <em>(optional)</em></span>
      <input type="text" name="properties[Favorite treat]" maxlength="30" autocomplete="off" placeholder="e.g. peanut butter biscuits">
    </label>
    <div class="wt-text" data-wt-text="{{ uid }}-book">
      <label class="wt-field">
        <span>Dedication on the first page <em>(optional, free)</em></span>
        <textarea name="properties[Book dedication]" maxlength="120" rows="2" placeholder="e.g. For Emma, the best big sister Sunny could ask for. Love, Mom & Dad" data-wt-input></textarea>
      </label>
      <div class="wt-dedication" aria-live="polite">
        <span class="wt-dedication__label">A note from you</span>
        <span class="wt-dedication__text wt-f-script" data-wt-out>Your dedication here</span>
      </div>
    </div>
  </section>
{%- endif -%}

<style>
  .wt-small { margin:0; font-size:13px; line-height:1.45; color:var(--muted); }
  .wt-upload { position:relative; display:flex; align-items:center; gap:14px; padding:16px; border:2px dashed var(--line); border-radius:14px; background:var(--bg); cursor:pointer; transition:border-color .15s, background .15s; }
  .wt-upload:hover, .wt-upload:focus-within { border-color:var(--thread); }
  .wt-upload.is-filled { border-style:solid; border-color:var(--fg); }
  .wt-upload__input { position:absolute; inset:0; opacity:0; cursor:pointer; width:100%; }
  .wt-upload__thumb { flex:none; display:grid; place-items:center; width:60px; height:60px; border-radius:12px; background:var(--surface); color:var(--thread); overflow:hidden; }
  .wt-upload__thumb img { width:100%; height:100%; object-fit:cover; }
  .wt-upload__text { display:grid; gap:2px; line-height:1.35; }
  .wt-upload__label { font:800 16px var(--body); }
  .wt-upload__hint { font-size:13px; color:var(--muted); }
  .wt-field { display:grid; gap:6px; font:700 15px var(--body); }
  .wt-field em { font-style:normal; font-weight:600; color:var(--muted); }
  .wt-field input, .wt-field textarea { font:600 16px var(--body); padding:12px 14px; border:1.5px solid var(--line); border-radius:12px; background:var(--bg); color:var(--fg); resize:vertical; }
  .wt-field input:focus, .wt-field textarea:focus { outline:none; border-color:var(--thread); box-shadow:0 0 0 3px color-mix(in srgb, var(--thread) 22%, transparent); }
  .wt-text { display:grid; gap:10px; }
  .wt-f-script { font-family:'Great Vibes', 'Snell Roundhand', cursive; font-weight:400; font-size:1.35em; }
  .wt-dedication { display:grid; justify-items:center; gap:6px; padding:20px 16px; text-align:center; background:var(--bg); border:1px solid var(--line); border-radius:10px; color:var(--fg); }
  .wt-dedication__label { font-size:.72em; letter-spacing:.16em; text-transform:uppercase; color:var(--muted); }
  .wt-dedication__text { line-height:1.3; word-break:break-word; }
  .wt-dedication__text.is-empty { opacity:.4; }
</style>
<script src="https://woven-tails.vercel.app/theme-assets/v6/wt-stylize.js" defer></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Great+Vibes&family=Nunito:wght@800&display=swap" rel="stylesheet">
<script>
  (() => {
    document.querySelectorAll('[data-wt-text^="{{ uid }}"]').forEach((wrap) => {
      if (wrap.dataset.wtBound) return;
      wrap.dataset.wtBound = '1';
      const input = wrap.querySelector('[data-wt-input]');
      const out = wrap.querySelector('[data-wt-out]');
      const placeholder = out.textContent;
      const render = () => {
        const v = input.value.trim();
        out.textContent = v || placeholder;
        out.classList.toggle('is-empty', !v);
      };
      const form = wrap.closest('form');
      if (form) form.addEventListener('formdata', (e) => {
        if (!input.value.trim()) e.formData.delete('properties[Blanket text style]');
      });
      wrap.querySelectorAll('[data-wt-font]').forEach((r) => r.addEventListener('change', () => {
        out.classList.remove('wt-f-classic', 'wt-f-script', 'wt-f-bold');
        out.classList.add('wt-f-' + r.dataset.wtFont);
      }));
      input.addEventListener('input', render);
      render();
    });
  })();
  (() => {
    const input = document.getElementById('wt-photo-{{ uid }}');
    if (!input || input.dataset.wtBound) return;
    input.dataset.wtBound = '1';
    input.addEventListener('click', () => window.wtWarmup && window.wtWarmup());
    input.addEventListener('change', () => {
      const box = input.closest('.wt-upload');
      const file = input.files && input.files[0];
      const img = box.querySelector('img');
      const svg = box.querySelector('svg');
      const label = box.querySelector('.wt-upload__label');
      if (!file) { box.classList.remove('is-filled'); img.hidden = true; svg.style.display = ''; label.textContent = "Upload your pet's photo"; return; }
      if (file.size > 20 * 1024 * 1024) { const n = document.querySelector('[data-wt-note="{{ uid }}"]'); if (n) n.textContent = 'That photo is over 20 MB. Please choose a smaller one.'; input.value = ''; return; }
      box.classList.add('is-filled');
      label.textContent = '✓ ' + file.name;
      const url = URL.createObjectURL(file);
      const probe = new Image();
      probe.onload = () => {
        img.src = url; img.hidden = false; svg.style.display = 'none';
        if (window.wtPreview) window.wtPreview('{{ uid }}', probe);
      };
      probe.onerror = () => {
        const note = document.querySelector('[data-wt-note="{{ uid }}"]');
        if (note) note.textContent = "Photo uploaded. Your browser can't show a preview of this file type, but we've got it.";
      };
      probe.src = url;
    });
  })();
  (() => {
    if (window.wtPreview) return;
    const STYLES = [[/royal/i, 'royal'], [/christmas|scarf/i, 'christmas'], [/pop/i, 'pop']];
    const styleFromPage = () => {
      for (const r of document.querySelectorAll('input[type=radio]:checked, select option:checked')) {
        const v = r.value || r.textContent || '';
        for (const [re, st] of STYLES) if (re.test(v)) return st;
      }
      return 'pop';
    };
    const state = {};
    const render = (uid) => {
      const st = state[uid]; if (!st || !window.wtStylize) return;
      const busy = document.querySelector('[data-wt-busy="' + uid + '"]');
      busy.hidden = false;
      const seq = (st.seq = (st.seq || 0) + 1);
      setTimeout(async () => {
        try {
          const canvas = await window.wtStylize(st.photo, styleFromPage(), st.view);
          if (seq !== st.seq) return;
          st.art.src = canvas.toDataURL('image/jpeg', 0.9);
          st.art.classList.add('is-user');
          document.dispatchEvent(new CustomEvent('wt:art', { detail: st.art.src }));
        } finally { if (seq === st.seq) busy.hidden = true; }
      }, 30);
    };
    window.wtPreview = (uid, photo) => {
      const art = document.querySelector('[data-wt-art="' + uid + '"]');
      if (!art) return;
      const fresh = !state[uid];
      state[uid] = { photo, art, view: { zoom: 1, ox: 0, oy: 0 } };
      const adjust = document.querySelector('[data-wt-adjust="' + uid + '"]');
      const note = document.querySelector('[data-wt-note="' + uid + '"]');
      adjust.hidden = false;
      adjust.querySelector('[data-wt-zoom]').value = 1;
      note.textContent = 'Instant preview, made in your browser. Our illustrators hand-finish your final artwork, and you approve it before anything is made.';
      if (fresh) {
        adjust.querySelector('[data-wt-zoom]').addEventListener('change', (e) => { state[uid].view.zoom = +e.target.value; render(uid); });
        let start = null;
        art.addEventListener('pointerdown', (e) => { if (!art.classList.contains('is-user')) return; start = [e.clientX, e.clientY]; art.setPointerCapture(e.pointerId); });
        art.addEventListener('pointermove', (e) => { if (start) art.style.transform = 'translate(' + (e.clientX - start[0]) + 'px,' + (e.clientY - start[1]) + 'px)'; });
        art.addEventListener('pointerup', (e) => {
          if (!start) return;
          const st = state[uid], ph = st.photo;
          const srcPerPx = Math.min(ph.naturalWidth, ph.naturalHeight) / st.view.zoom / art.clientWidth;
          st.view.ox -= (e.clientX - start[0]) * srcPerPx; st.view.oy -= (e.clientY - start[1]) * srcPerPx;
          start = null; art.style.transform = ''; render(uid);
        });
      }
      render(uid);
    };
    document.addEventListener('change', (e) => {
      const t = e.target;
      if (!(t instanceof HTMLInputElement || t instanceof HTMLSelectElement)) return;
      if (t.closest('.wt-personalize')) return;
      setTimeout(() => Object.keys(state).forEach(render), 50);
    });
  })();
</script>
{%- endif -%}
