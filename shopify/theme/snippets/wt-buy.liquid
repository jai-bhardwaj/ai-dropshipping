{%- comment -%} Woven Tails buy form: variant chips + personalization, straight to checkout. {%- endcomment -%}
{%- assign current = product.selected_or_first_available_variant -%}
<div class="wt-buy" data-buy-anchor>
  {%- form 'product', product, id: 'wt-buy-form', class: 'wt-buy__form' -%}
    <input type="hidden" name="id" value="{{ current.id }}" data-wt-variant>
    <input type="hidden" name="return_to" value="/checkout">
    {%- unless product.has_only_default_variant -%}
      {%- for option in product.options_with_values -%}
        <div class="picker">
          <span class="picker-label">{{ option.name }}</span>
          <div class="chips">
            {%- for value in option.values -%}
              <label class="chip text"><input class="wt-opt" type="radio" name="wt-option-{{ forloop.parentloop.index0 }}" data-index="{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}><span>{{ value }}</span></label>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    {%- endunless -%}
    {% render 'woven-personalization', product: product, uid: 'buy' %}
    <button type="submit" class="btn wt-buy__btn" {% unless current.available %}disabled{% endunless %}>Create mine · <span data-wt-price>{{ current.price | money_without_trailing_zeros }}</span></button>
    <p class="note wt-buy__note">Secure checkout · free US shipping · you approve the art before anything is made</p>
  {%- endform -%}
  <script type="application/json" data-wt-variants>[{%- for v in product.variants -%}{"id":{{ v.id }},"options":{{ v.options | json }},"price":{{ v.price | money_without_trailing_zeros | json }},"available":{{ v.available | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]</script>
  <script>
    (() => {
      const root = document.currentScript.closest('.wt-buy');
      const variants = JSON.parse(root.querySelector('[data-wt-variants]').textContent);
      const idInput = root.querySelector('[data-wt-variant]'), price = root.querySelector('[data-wt-price]'), btn = root.querySelector('.wt-buy__btn');
      const STYLE = [[/royal/i, 'royal'], [/christmas|scarf/i, 'christmas'], [/pop/i, 'pop']];
      const sync = () => {
        const sel = [...root.querySelectorAll('.wt-opt:checked')].sort((a, b) => a.dataset.index - b.dataset.index).map((i) => i.value);
        const v = variants.find((x) => x.options.every((o, i) => o === sel[i]));
        if (v) { idInput.value = v.id; price.textContent = v.price; btn.disabled = !v.available; }
        for (const val of sel) for (const [re, st] of STYLE) if (re.test(val)) document.dispatchEvent(new CustomEvent('wt:style', { detail: st }));
      };
      root.addEventListener('change', (e) => { if (e.target.classList.contains('wt-opt')) sync(); });
      root.querySelector('form').addEventListener('submit', () => { btn.disabled = true; btn.textContent = 'Taking you to checkout…'; });
    })();
  </script>
</div>
