<main class="wrap wt-shell">
  <header class="wt-shell__head"><span class="eyebrow">Search</span><h1>{% if search.performed %}Results for “{{ search.terms | escape }}”{% else %}Search the shop{% endif %}</h1></header>
  <form action="{{ routes.search_url }}" method="get" role="search" class="wt-search">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Blanket, storybook, gift…" aria-label="Search">
    <button class="btn" type="submit">Search</button>
  </form>
  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <ul class="wt-list">{% for item in search.results %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{% endfor %}</ul>
    {%- else -%}<p class="lede">Nothing matched. Here's everything we make:</p>{% render 'wt-product-grid' %}{%- endif -%}
  {%- endif -%}
</main>
{% schema %}{ "name": "Woven Tails search", "settings": [] }{% endschema %}
