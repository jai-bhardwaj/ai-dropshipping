{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/(img|tex|video)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] },
    { "source": "/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ],
  "redirects": [
    { "source": "/render", "destination": "/", "permanent": false }
  ]
}
